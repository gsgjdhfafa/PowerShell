# Kopieren nach .env und ausfuellen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Mindestens einer der beiden:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# KI-Auswahl: openai | claude
AI_PROVIDER=claude
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-opus-4-7

# Notion
NOTION_TOKEN=
NOTION_DB_MEMORY=
NOTION_DB_TASKS=
NOTION_DB_COSTS=

# --- Webhook (Mail Worker) ---
# WEBHOOK_SECRET muss >= 32 Zeichen sein. Wird auch im CF Worker als Secret hinterlegt.
WEBHOOK_PORT=8080
WEBHOOK_SECRET=

# --- Google (Tasks + Calendar) ---
# Aus oauth-helper.mjs (lokal). Leer lassen, um Sync zu deaktivieren.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TASKS_LIST_ID=
GOOGLE_CALENDAR_ID=primary

# --- Cloudflare Tunnel ---
# Token aus Cloudflare Zero Trust -> Networks -> Tunnels.
CF_TUNNEL_TOKEN=
